<Group view="code" labelreference="L143" drawlabel="true">
<Input>
<Text-field style="Heading 2" layout="Heading 2">Example 2</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L282" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">jnsum := 2^n*(a*d-b*c)^n*pochhammer(-p+1-I*q*(1/2), n)*hyperterm([-n, n+1-2*p], [-p+1-I*q*(1/2)], I*(a^2+c^2)*(x-(I*(a*d-b*c)-a*b-c*d)/(a^2+c^2))/(2*(a*d-b*c)), j)/I^n;</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L281" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">Rjn := sumrecursion(jnsum, j, S(n), recursion = up);</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L280" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">REtoDE(Rjn, S(n), x);</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L142" drawlabel="true">
<Input>
<Text-field style="Heading 2" layout="Heading 2">Example 4</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" hide-input="false" labelreference="L284" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">qhsum := subs([alpha = 2*beta, beta = 1], qphihyperterm([q^(-n), alpha*beta*q^(n+1), x], [alpha*q, q^(-N)], q, q, j));</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L283" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">RE := qsumrecursion(qhsum, q, j, S(n), recursion = up);</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L288" drawlabel="true" applyint="true" applyrational="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">REtoqde(RE, S(n), x, q);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L289" drawlabel="true" applyint="true" applyrational="true">
<Input>
<Text-field style="Heading 2" layout="Heading 2">Meixner </Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L542" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">msum := proc (b, c, x, j) hyperterm([-n, -x], [beta], 1-1/c, j) end proc;</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L544" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">RM1 := sumrecursion(msum(b, c, x, j), j, S(n), recursion = up);</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L534" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">RM2 := sumrecursion(msum(beta, 1/c, -x-beta, j), j, S(n), recursion = up);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L537" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">`recursion/compare`(RM1, RM2, S(n));</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L546" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">msum(beta, 1/c, -x-beta, n);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L545" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">denumM := msum(beta, 1/c, -x-beta, n)/pochhammer(x+beta, n);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L540" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">msum(b, c, x, n);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L535" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">numM := msum(b, c, x, n)*(-1)^n/pochhammer(-x, n);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L538" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">CM := denumM/numM;</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L541" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal"></Text-field>
</Input>
</Group>
<Group view="code" labelreference="L543" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">NRM1 := sumrecursion(CM*msum(b, c, x, j), j, S(n), recursion = up);</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L536" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">`recursion/compare`(NRM1, RM2, S(n));</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L539" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">simplify([seq(CM*add(msum(b, c, x, j), j = 0 .. n), n = 0 .. 3)-seq(add(msum(beta, 1/c, -x-beta, j), j = 0 .. n), n = 0 .. 3)]);</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L285" drawlabel="true" applyint="true" applyrational="true">
<Input>
<Text-field style="Heading 2" layout="Heading 2">Krawtchouk </Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
<Group view="code" labelreference="L548" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">ksum := proc (p, N, x, j) hyperterm([-n, -x], [-N], 1/p, j) end proc;</Text-field>
</Input>
</Group>
